# Copy to .env.local and fill in. None are required for the site to run in dev;
# the contact API falls back to a logged stub when RESEND_API_KEY is absent.

# Public site URL (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.prabhdeepsandhu.ca

# --- Email (optional) -------------------------------------------------------
# Create a key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
# Where contact/showing/valuation leads are delivered:
LEAD_INBOX_EMAIL=prabhsandhu@winmaxrealestate.ca
# Verified "from" address on your domain (Resend requires a verified domain):
LEAD_FROM_EMAIL=website@prabhdeepsandhu.ca

# --- Future MLS® DDF/IDX feed (optional) ------------------------------------
# Supplied by the brokerage / CREA DDF. Leave blank to use sample listings.
DDF_FEED_URL=
DDF_API_KEY=
